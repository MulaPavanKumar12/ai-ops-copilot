# ---------------------------------------------------------------------------
# AI Ops Copilot configuration. Copy to `.env` and adjust:
#     cp .env.example .env        (Windows: copy .env.example .env)
# `.env` is git-ignored. Never commit real secrets. Empty values = defaults.
# ---------------------------------------------------------------------------

# --- App ---------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# text (human readable) or json (for containers / log shippers)
LOG_FORMAT=text

# --- Storage -------------------------------------------------------------
# Leave DATABASE_URL empty to use a local SQLite file (data/aiops.db): no setup needed.
# To use PostgreSQL (e.g. the one in docker-compose):
#   DATABASE_URL=postgresql+psycopg://aiops:<password>@localhost:5432/aiops
DATABASE_URL=
# Used by docker-compose to create the PostgreSQL container.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aiops
POSTGRES_USER=aiops
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Where generated data, trained models and evaluation reports go.
# DATA_DIR=data
# MODEL_DIR=models
# REPORTS_DIR=reports

# --- LLM root-cause analysis --------------------------------------------------
# With a key, a Claude agent investigates each incident with tools (metrics, logs,
# knowledge-base search). Without a key, or if the API fails, the offline
# retrieval engine is used automatically. Get a key at https://console.anthropic.com
# anthropic | none
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5
# low | medium | high (more effort = deeper reasoning, slower, costlier)
LLM_EFFORT=medium
LLM_TIMEOUT_SECONDS=90
LLM_MAX_TOOL_ROUNDS=6

# --- RAG knowledge base ------------------------------------------------------
# lsa (built in, offline) | sentence-transformers (pip install sentence-transformers)
EMBEDDING_BACKEND=lsa
# chroma (persistent ChromaDB) | memory (numpy, no extra deps)
VECTOR_STORE=chroma
RAG_TOP_K=5

# --- Backend API ---------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# If set, every /api/v1 call needs header X-API-Key. Set it in production.
API_KEY=
API_RATE_LIMIT_PER_MINUTE=240
CORS_ORIGINS=http://localhost:8501

# --- Alerts ------------------------------------------------------------------------
# Slack incoming webhook (must start with https://hooks.slack.com/). Empty = Slack off.
SLACK_WEBHOOK_URL=
# Email via SMTP (STARTTLS). Empty SMTP_HOST = email off.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=aiops-copilot@localhost
# Comma-separated list of recipients
ALERT_EMAIL_TO=
# Do not re-send the same alert on the same channel within this many minutes
ALERT_COOLDOWN_MINUTES=30

# --- Real-time worker + dashboard ----------------------------------------------------
SIMULATOR_URL=http://localhost:8001
API_URL=http://localhost:8000
# Poll faster than SIM_TICK_SECONDS so no sample is missed.
WORKER_POLL_SECONDS=2
WORKER_RUN_RCA=true

# --- Synthetic dataset generator (batch, offline) -------------------------
GEN_SEED=42
GEN_DURATION_HOURS=24
GEN_STEP_SECONDS=60
GEN_INCIDENTS_PER_DAY=14
GEN_START=2026-01-05T00:00:00Z

# --- Live fleet simulator (stands in for real servers) ---------------------
SIM_HOST=0.0.0.0
SIM_PORT=8001
# Real seconds between ticks, and how much faster simulated time runs.
# 5s x 12 = each tick advances 1 simulated minute.
SIM_TICK_SECONDS=5
SIM_SPEEDUP=12
# Chance per tick that a random incident starts somewhere in the fleet.
SIM_INCIDENT_PROBABILITY=0.02
SIM_LOG_MAX_MB=50
# If set, POST /api/v1/incidents/inject requires header X-Admin-Token.
SIM_ADMIN_TOKEN=

# --- Docker (Linux only): your user id so the generator container can write ./data
HOST_UID=1000
HOST_GID=1000

# --- Grafana (docker-compose) ---------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-too
